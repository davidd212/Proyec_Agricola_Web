<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Panel Admin AgroVentas</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/css/modal-detalle.css" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
    <style>
        body.admin-mode {
            padding-left: 250px;
        }

        .admin-sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 250px;
            height: 100vh;
            background: linear-gradient(135deg, #2e7d32 0%, #1b5e20 100%);
            color: white;
            padding-top: 0;
            overflow-y: auto;
            box-shadow: 2px 0 8px rgba(0, 0, 0, 0.15);
            z-index: 1000;
        }

        .admin-sidebar-header {
            padding: 20px 15px;
            background: rgba(0, 0, 0, 0.15);
            border-bottom: 1px solid rgba(255, 255, 255, 0.15);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .admin-sidebar-logo {
            width: 40px;
            height: 40px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .admin-sidebar-header h5 {
            margin: 0;
            font-size: 14px;
            font-weight: 700;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .admin-sidebar-header small {
            display: block;
            font-size: 11px;
            color: rgba(255, 255, 255, 0.7);
            font-weight: 400;
        }

        .admin-nav {
            list-style: none;
            padding: 15px 0;
            margin: 0;
        }

        .admin-nav li {
            margin: 0;
        }

        .admin-nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 15px;
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            transition: all 0.3s ease;
            border-left: 3px solid transparent;
            font-size: 14px;
        }

        .admin-nav a:hover {
            background-color: rgba(255, 255, 255, 0.1);
            color: white;
            border-left-color: white;
        }

        .admin-nav a.active {
            background-color: rgba(255, 255, 255, 0.15);
            color: white;
            border-left-color: white;
            font-weight: 600;
        }

        .admin-nav i {
            font-size: 16px;
            width: 18px;
            text-align: center;
        }

        /* Badge de admin en navbar */
        .admin-badge {
            display: inline-block;
            background: #fff3cd;
            color: #b8860b;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 700;
            margin-left: 8px;
        }

        @@media (max-width: 768px) {
            body.admin-mode {
                padding-left: 0;
            }

            .admin-sidebar {
                width: 200px;
                transform: translateX(-100%);
                transition: transform 0.3s ease;
            }

            .admin-sidebar.show {
                transform: translateX(0);
            }

            .admin-sidebar-header {
                padding: 15px 10px;
            }

            .admin-nav a {
                padding: 10px 12px;
                font-size: 13px;
            }
        }
    </style>
</head>
<body class="admin-mode">
    <!-- Sidebar Admin -->
    <aside class="admin-sidebar">
        <div class="admin-sidebar-header">
            <div class="admin-sidebar-logo">
                <i class="fas fa-leaf"></i>
            </div>
            <div>
                <h5>AgroVentas</h5>
                <small>Admin Portal</small>
            </div>
        </div>
        <ul class="admin-nav">
            <li>
                <a href="@Url.Action("Dashboard", "Admin")" 
                   class="@(ViewContext.RouteData.Values["action"].ToString() == "Dashboard" ? "active" : "")">
                    <i class="fas fa-chart-line"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("GestionarProductos", "Admin")" 
                   class="@((ViewContext.RouteData.Values["action"].ToString() == "GestionarProductos") ? "active" : "")">
                    <i class="fas fa-box"></i>
                    <span>Productos</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("Pedidos", "Admin")" 
                   class="@((ViewContext.RouteData.Values["action"].ToString() == "Pedidos" || ViewContext.RouteData.Values["action"].ToString() == "DetallePedido") ? "active" : "")">
                    <i class="fas fa-shopping-bag"></i>
                    <span>Pedidos</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("GestionarUsuarios", "Admin")" 
                   class="@((ViewContext.RouteData.Values["action"].ToString() == "GestionarUsuarios") ? "active" : "")">
                    <i class="fas fa-users"></i>
                    <span>Usuarios</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("Mensajes", "Admin")" 
                   class="@((ViewContext.RouteData.Values["action"].ToString() == "Mensajes" || ViewContext.RouteData.Values["action"].ToString() == "VerMensaje") ? "active" : "")">
                    <i class="fas fa-envelope"></i>
                    <span>Mensajes</span>
                </a>
            </li>
            <li style="border-top: 1px solid rgba(255, 255, 255, 0.2); margin-top: 10px; padding-top: 10px;">
                <a href="@Url.Action("Index", "Home")">
                    <i class="fas fa-arrow-left"></i>
                    <span>Salir Admin</span>
                </a>
            </li>
        </ul>
    </aside>

    <!-- Navbar Principal (igual a la pública) -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top" style="background: linear-gradient(135deg, #2e7d32 0%, #1b5e20 100%) !important;">
        <div class="container">
            <a class="navbar-brand fw-bold" href="@Url.Action("Index", "Home")" style="color: white; font-size: 1.5rem;">
                <i class="fas fa-leaf" style="margin-right: 8px;"></i> AgroVentas
                <span class="admin-badge">
                    <i class="fas fa-crown" style="margin-right: 4px;"></i>ADMIN
                </span>
            </a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" 
                    title="Alternar navegación" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation" style="border-color: rgba(255,255,255,0.3);">
                <span class="navbar-toggler-icon" style="background-image: url('data:image/svg+xml,%3csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 30 30%22%3e%3cpath stroke=%22rgba%28255,255,255,0.8%29%22 stroke-linecap=%22round%22 stroke-miterlimit=%2210%22 stroke-width=%222%22 d=%22M4 7h22M4 15h22M4 23h22%22/%3e%3c/svg%3e');"></span>
            </button>
            <div class="collapse navbar-collapse">
                <div style="margin-left: auto; display: flex; align-items: center; gap: 15px;">
                    <span style="color: white; font-weight: 500; display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-user-circle fa-lg"></i>
                        @(Session["Nombre"] ?? "Administrador")
                    </span>
                    @Html.ActionLink("Cerrar Sesión", "Logout", "Login", new { }, new { @class = "btn btn-sm btn-light", style = "border-radius: 20px; padding: 6px 16px; font-size: 0.85rem; font-weight: 500;" })
                </div>
            </div>
        </div>
    </nav>

    <!-- Contenido -->
    <div class="container-fluid" style="padding-top: 20px; padding-bottom: 40px;">
        @RenderBody()
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
