@model Proyec_Agricola_Web.Models.Carrito

@{
    ViewBag.Title = "Mi Carrito - AgroVentas";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h2>
                <i class="fas fa-shopping-cart"></i> Mi Carrito de Compras
            </h2>
            <hr />

            @if (Model == null || Model.DetalleItems == null || Model.DetalleItems.Count == 0)
            {
                <div class="alert alert-info">
                    <p>Tu carrito está vacío.</p>
                    <a href="@Url.Action("Index", "Producto")" class="btn btn-primary">
                        <i class="fas fa-arrow-right"></i> Continuar Comprando
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Producto</th>
                                <th>Imagen</th>
                                <th>Precio Unitario</th>
                                <th>Cantidad</th>
                                <th>Subtotal</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.DetalleItems)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.NombreProducto</strong>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ImagenProducto))
                                        {
                                            <img src="@item.ImagenProducto" alt="@item.NombreProducto" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;" />
                                        }
                                        else
                                        {
                                            <i class="fas fa-image text-muted"></i>
                                        }
                                    </td>
                                    <td>
                                        $@item.PrecioUnitario.ToString("F2")
                                    </td>
                                    <td>
                                        <input type="number" min="1" value="@item.Cantidad" class="form-control" style="width: 80px;" 
                                               onchange="ActualizarCantidad(@item.ProductoID, this.value)" />
                                    </td>
                                    <td>
                                        <span class="text-success font-weight-bold">$<span class="item-subtotal">@item.PrecioTotal.ToString("F2")</span></span>
                                    </td>
                                    <td>
                                        <button class="btn btn-danger btn-sm" onclick="EliminarProducto(@item.ProductoID)" title="Eliminar producto">
                                            <i class="fa fa-trash"></i> Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row mt-4">
                    <div class="col-md-8">
                        <a href="@Url.Action("Index", "Producto")" class="btn btn-outline-primary">
                            <i class="fa fa-arrow-left"></i> Continuar Comprando
                        </a>
                        <button class="btn btn-outline-danger" onclick="VaciarCarrito()">
                            <i class="fa fa-trash"></i> Vaciar Carrito
                        </button>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-success">
                            <div class="card-header bg-success text-white">
                                <h5 class="mb-0">Resumen de Compra</h5>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between mb-2">
                                    <strong>Artículos:</strong>
                                    <span id="cantidad-items">@Model.DetalleItems.Count</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <strong>Subtotal:</strong>
                                    <span>$<span id="subtotal">@Model.DetalleItems.Sum(x => x.PrecioTotal).ToString("F2")</span></span>
                                </div>
                                <div class="d-flex justify-content-between mb-3">
                                    <strong>Envío:</strong>
                                    <span>$<span id="envio">0.00</span></span>
                                </div>
                                <hr />
                                <div class="d-flex justify-content-between">
                                    <h6 class="mb-0"><strong>Total:</strong></h6>
                                    <h6 class="mb-0 text-success"><strong>$<span id="total">@Model.DetalleItems.Sum(x => x.PrecioTotal).ToString("F2")</span></strong></h6>
                                </div>
                                <button class="btn btn-success btn-block btn-lg mt-3 w-100" onclick="ProcesarPago()">
                                    <i class="fas fa-credit-card"></i> Proceder al Pago
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script type="text/javascript">
function ActualizarCantidad(productoID, cantidad) {
    var cantidadInt = parseInt(cantidad);
    
    if (cantidadInt <= 0) {
        alert('La cantidad debe ser mayor a 0');
        location.reload();
        return;
    }

    $.ajax({
        url: '@Url.Action("ActualizarCantidad", "Carrito")',
        type: 'POST',
        data: {
            productoID: productoID,
            cantidad: cantidadInt
        },
        success: function (response) {
            if (response.success) {
                location.reload();
            } else {
                alert(response.message);
                location.reload();
            }
        },
        error: function () {
            alert('Error al actualizar la cantidad');
        }
    });
}

function EliminarProducto(productoID) {
    if (confirm('¿Estás seguro de que deseas eliminar este producto del carrito?')) {
        $.ajax({
            url: '@Url.Action("Eliminar", "Carrito")',
            type: 'POST',
            data: { productoID: productoID },
            success: function (response) {
                if (response.success) {
                    location.reload();
                } else {
                    alert(response.message);
                }
            },
            error: function () {
                alert('Error al eliminar el producto');
            }
        });
    }
}

function VaciarCarrito() {
    if (confirm('¿Estás seguro de que deseas vaciar el carrito completamente?')) {
        $.ajax({
            url: '@Url.Action("Vaciar", "Carrito")',
            type: 'POST',
            success: function (response) {
                if (response.success) {
                    location.reload();
                } else {
                    alert(response.message);
                }
            },
            error: function () {
                alert('Error al vaciar el carrito');
            }
        });
    }
}

function ProcesarPago() {
    alert('Funcionalidad de pago en desarrollo');
    // Aquí irá el código para procesar el pago
}
</script>
