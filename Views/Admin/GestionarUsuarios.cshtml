@model List<Proyec_Agricola_Web.Models.Usuario>

@{
    ViewBag.Title = "Usuarios - Administración";
}

<div class="bg-light py-3 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Inicio</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Admin")">Dashboard</a></li>
                <li class="breadcrumb-item active">Usuarios</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container my-5">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <h1 style="color:#1a1a1a; font-weight:700; margin:0;">
            <i class="fas fa-users" style="color:#2e7d32;"></i> Usuarios
        </h1>
        <span style="background:#e8f5e9; color:#2e7d32; padding:6px 16px; border-radius:20px; font-weight:600; font-size:0.9rem;">
            @Model.Count usuario(s)
        </span>
    </div>

    <div style="background:white; border-radius:16px; box-shadow:0 2px 12px rgba(0,0,0,0.06); overflow:hidden;">
        @if (Model != null && Model.Count > 0)
        {
            <div style="overflow-x:auto;">
                <table style="width:100%; border-collapse:collapse;">
                    <thead style="background:#2e7d32; color:white;">
                        <tr>
                            <th style="padding:14px 12px; text-align:left;">Nombre</th>
                            <th style="padding:14px 12px; text-align:left;">Email</th>
                            <th style="padding:14px 12px; text-align:left;">Teléfono</th>
                            <th style="padding:14px 12px; text-align:left;">Dirección</th>
                            <th style="padding:14px 12px; text-align:center;">Tipo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr style="border-bottom:1px solid #f0f0f0;">
                                <td style="padding:12px;">
                                    <div style="display:flex; align-items:center; gap:10px;">
                                        <div style="width:40px; height:40px; background:#e8f5e9; border-radius:50%; display:flex; align-items:center; justify-content:center;">
                                            <i class="fas fa-user" style="color:#2e7d32;"></i>
                                        </div>
                                        <div>
                                            <div style="font-weight:600; color:#1a1a1a;">@user.Nombre @user.Apellido_Paterno @user.Apellido_Materno</div>
                                            <div style="font-size:0.8rem; color:#999;">@@@user.Nombre</div>
                                        </div>
                                    </div>
                                </td>
                                <td style="padding:12px; color:#555;">@user.Email</td>
                                <td style="padding:12px; color:#555;">@user.Telefono</td>
                                <td style="padding:12px; color:#555; max-width:200px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@user.Direccion, @user.Ciudad</td>
                                <td style="padding:12px; text-align:center;">
                                    @if (user.TipoUsuario == 1)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fas fa-crown"></i> Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Cliente</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="text-align:center; padding:60px 20px;">
                <i class="fas fa-users fa-3x" style="color:#28a745; opacity:0.2; margin-bottom:15px;"></i>
                <p class="text-muted">No hay usuarios registrados.</p>
            </div>
        }
    </div>
</div>
