@{
    ViewBag.Title = "Dashboard - Administración";
}

<style>
    .dashboard-header {
        background: linear-gradient(135deg, #f5f5f5 0%, #f9f9f9 100%);
        padding: 24px;
        margin: -20px -20px 0 -20px;
        border-bottom: 1px solid #e0e0e0;
    }

    .dashboard-title {
        color: #1a1a1a;
        font-weight: 600;
        font-size: 24px;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 24px;
        border: 1px solid #e8e8e8;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .stat-card:hover {
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        transform: translateY(-2px);
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #2e7d32, #1b5e20);
    }

    .stat-card.blue::before {
        background: linear-gradient(90deg, #1565C0, #0D47A1);
    }

    .stat-card.orange::before {
        background: linear-gradient(90deg, #E65100, #BF360C);
    }

    .stat-card.purple::before {
        background: linear-gradient(90deg, #6A1B9A, #4A148C);
    }

    .stat-icon {
        position: absolute;
        top: 20px;
        right: 20px;
        font-size: 32px;
        opacity: 0.1;
        color: #2e7d32;
    }

    .stat-card.blue .stat-icon {
        color: #1565C0;
    }

    .stat-card.orange .stat-icon {
        color: #E65100;
    }

    .stat-card.purple .stat-icon {
        color: #6A1B9A;
    }

    .stat-label {
        font-size: 13px;
        color: #999;
        margin-bottom: 8px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .stat-value {
        font-size: 32px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 8px;
    }

    .stat-change {
        font-size: 12px;
        color: #4caf50;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .stat-change.negative {
        color: #f44336;
    }
</style>

<div class="dashboard-header">
    <h1 class="dashboard-title">
        <i class="fas fa-chart-line" style="color: #2e7d32;"></i>
        AgroVentas Dashboard
    </h1>
</div>

<div style="padding: 24px;">
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-info">@TempData["Mensaje"]</div>
    }

    <!-- Estadísticas principales -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 32px;">
        <div class="stat-card">
            <i class="fas fa-box stat-icon"></i>
            <div class="stat-label"><i class="fas fa-leaf" style="color: #2e7d32;"></i> Total Productos</div>
            <div class="stat-value">@ViewBag.TotalProductos</div>
        </div>

        <div class="stat-card blue">
            <i class="fas fa-shopping-cart stat-icon"></i>
            <div class="stat-label"><i class="fas fa-tractor" style="color: #1565C0;"></i> Pedidos Recientes</div>
            <div class="stat-value">@ViewBag.TotalPedidos</div>
        </div>

        <div class="stat-card orange">
            <i class="fas fa-users stat-icon"></i>
            <div class="stat-label"><i class="fas fa-user-circle" style="color: #E65100;"></i> Nuevos Usuarios</div>
            <div class="stat-value">@ViewBag.TotalUsuarios</div>
        </div>
    </div>

    <!-- Sección principal: Gráfico de categorías y Actividad en vivo -->
    <div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 24px; margin-bottom: 32px;">
        <!-- Ventas por Categoría -->
        <div class="stat-card" style="padding: 32px;">
            <h5 style="color: #1a1a1a; font-weight: 600; margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-chart-pie" style="color: #2e7d32;"></i>
                Ventas por Categoría
            </h5>
            @{
                var ventasCategoria = ViewBag.VentasPorCategoria as Dictionary<string, decimal>;
                decimal totalVentas = ventasCategoria != null ? ventasCategoria.Values.Sum() : 0;
                var colores = new[] { "#2e7d32", "#1565C0", "#E65100", "#6A1B9A", "#00838f", "#f9a825", "#d32f2f", "#5d4037" };
                int idxColor = 0;
            }
            <div style="text-align: center; margin: 40px 0;">
                <div style="width: 180px; height: 180px; margin: 0 auto; position: relative;">
                    @if (ventasCategoria != null && ventasCategoria.Count > 0 && totalVentas > 0)
                    {
                        decimal acumulado = 0;
                        var gradientParts = new List<string>();
                        foreach (var kvp in ventasCategoria)
                        {
                            decimal angulo = kvp.Value / totalVentas * 360;
                            decimal start = acumulado;
                            decimal end = acumulado + angulo;
                            string color = colores[idxColor % colores.Length];
                            gradientParts.Add($"{color} {start:F1}deg {end:F1}deg");
                            acumulado = end;
                            idxColor++;
                        }
                        string conicGradient = "conic-gradient(" + string.Join(", ", gradientParts) + ")";
                        <div style="width: 100%; height: 100%; border-radius: 50%; background: @conicGradient; position: relative;">
                            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 120px; height: 120px; background: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; color: #2e7d32; font-size: 14px; text-align: center;">
                                $@totalVentas.ToString("N0")
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="width: 100%; height: 100%; border-radius: 50%; background: #e0e0e0; position: relative; display: flex; align-items: center; justify-content: center;">
                            <span style="color: #999; font-size: 13px;">Sin ventas</span>
                        </div>
                    }
                </div>
            </div>
            @if (ventasCategoria != null && ventasCategoria.Count > 0)
            {
                idxColor = 0;
                <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; font-size: 12px; margin-top: 24px;">
                    @foreach (var kvp in ventasCategoria)
                    {
                        string color = colores[idxColor % colores.Length];
                        decimal porcentaje = totalVentas > 0 ? kvp.Value / totalVentas * 100 : 0;
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <span style="width: 12px; height: 12px; background: @color; border-radius: 3px;"></span>
                            <span>@kvp.Key (@porcentaje.ToString("F1")%)</span>
                        </div>
                        idxColor++;
                    }
                </div>
            }
        </div>

        <!-- Actividad en Vivo -->
        <div class="stat-card" style="padding: 32px;">
            <h5 style="color: #1a1a1a; font-weight: 600; margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-bolt" style="color: #ff9800;"></i>
                Actividad en Vivo
            </h5>
            <div style="max-height: 320px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px;">
                @{
                    var actividad = ViewBag.ActividadReciente as List<Proyec_Agricola_Web.Controllers.ActividadItem>;
                }
                @if (actividad != null && actividad.Count > 0)
                {
                    foreach (var item in actividad)
                    {
                        var timeAgo = "";
                        var diff = DateTime.Now - item.Fecha;
                        if (diff.TotalMinutes < 1) {
                            timeAgo = "Ahora";
                        }
                        else if (diff.TotalMinutes < 60) {
                            timeAgo = $"{(int)diff.TotalMinutes}m ago";
                        }
                        else if (diff.TotalHours < 24) {
                            timeAgo = $"{(int)diff.TotalHours}h ago";
                        }
                        else {
                            timeAgo = $"{(int)diff.TotalDays}d ago";
                        }

                        <div style="display: flex; gap: 12px; padding: 12px; background: #f9f9f9; border-radius: 8px; align-items: flex-start;">
                            <div style="width: 40px; height: 40px; background: @item.Fondo; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                <i class="fas fa-@item.Icono" style="color: @item.Color;"></i>
                            </div>
                            <div style="flex: 1; font-size: 13px;">
                                <div style="color: #1a1a1a; font-weight: 500;">@item.Descripcion</div>
                                <div style="color: #999; font-size: 12px; margin-top: 4px;">@timeAgo</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align: center; padding: 24px; color: #999; font-size: 13px;">
                        <i class="fas fa-inbox" style="font-size: 24px; display: block; margin-bottom: 8px;"></i>
                        No hay actividad reciente
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Tabla de Últimos Pedidos -->
    <div class="stat-card" style="padding: 32px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <h5 style="color: #1a1a1a; font-weight: 600; margin: 0; display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-clock" style="color: #2e7d32;"></i>
                Últimos Pedidos
            </h5>
            <a href="@Url.Action("Pedidos", "Admin")" style="color: #2e7d32; font-size: 13px; text-decoration: none; font-weight: 500;">
                Ver todos <i class="fas fa-arrow-right" style="margin-left: 4px;"></i>
            </a>
        </div>

        @{
            var ultimosPedidos = ViewBag.UltimosPedidos as List<Proyec_Agricola_Web.Models.Pedido>;
        }

        @if (ultimosPedidos != null && ultimosPedidos.Count > 0)
        {
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                    <thead>
                        <tr style="border-bottom: 2px solid #e8e8e8; background: #f9f9f9;">
                            <th style="padding: 14px 8px; text-align: left; color: #666; font-weight: 600;">Pedido</th>
                            <th style="padding: 14px 8px; text-align: left; color: #666; font-weight: 600;">Cliente</th>
                            <th style="padding: 14px 8px; text-align: left; color: #666; font-weight: 600;">Fecha</th>
                            <th style="padding: 14px 8px; text-align: left; color: #666; font-weight: 600;">Total</th>
                            <th style="padding: 14px 8px; text-align: left; color: #666; font-weight: 600;">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pedido in ultimosPedidos.Take(5))
                        {
                            <tr style="border-bottom: 1px solid #f0f0f0;">
                                <td style="padding: 14px 8px; font-weight: 600; color: #2e7d32;">#@pedido.PedidoID</td>
                                <td style="padding: 14px 8px; color: #1a1a1a;">@pedido.NombreCliente</td>
                                <td style="padding: 14px 8px; color: #666;">@pedido.FechaPedido.ToString("dd/MM/yyyy")</td>
                                <td style="padding: 14px 8px; font-weight: 600; color: #1a1a1a;">$@pedido.Total.ToString("F2")</td>
                                <td style="padding: 14px 8px;">
                                    @switch (pedido.Estado)
                                    {
                                        case "Pendiente":
                                            <span style="display: inline-block; background: #fff3cd; color: #856404; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 500;">Pendiente</span>
                                            break;
                                        case "Procesando":
                                            <span style="display: inline-block; background: #cfe2ff; color: #084298; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 500;">Procesando</span>
                                            break;
                                        case "Enviado":
                                            <span style="display: inline-block; background: #d1ecf1; color: #0c5460; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 500;">Enviado</span>
                                            break;
                                        case "Entregado":
                                            <span style="display: inline-block; background: #d4edda; color: #155724; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 500;">Entregado</span>
                                            break;
                                        case "Cancelado":
                                            <span style="display: inline-block; background: #f8d7da; color: #721c24; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 500;">Cancelado</span>
                                            break;
                                        default:
                                            <span style="display: inline-block; background: #e2e3e5; color: #383d41; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 500;">@pedido.Estado</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p style="color: #999; text-align: center; padding: 24px;">No hay pedidos registrados.</p>
        }
    </div>
</div>
