@{
    ViewBag.Title = "Carrito de Compras - AgroVentas";
}

<!-- Breadcrumb -->
<div class="bg-light py-3 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Inicio</a></li>
                <li class="breadcrumb-item active">Carrito de Compras</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container my-5">
    <h1 style="color: var(--color-dark); font-weight: 700; margin-bottom: 30px;">
        <i class="fas fa-shopping-cart"></i> Carrito de Compras
    </h1>

    <div class="row">
        <div class="col-md-8">
            <!-- Carrito vacío -->
            <div class="alert alert-info" role="alert" style="text-align: center; padding: 60px 20px;">
                <i class="fas fa-info-circle" style="font-size: 48px; margin-bottom: 20px;"></i>
                <h4>Tu carrito está vacío</h4>
                <p class="text-muted mb-4">¡Empieza a comprar nuestros productos agrícolas!</p>
                <a href="@Url.Action("Productos", "Home")" class="btn btn-success btn-lg">
                    <i class="fas fa-shopping-bag"></i> Continuar Comprando
                </a>
            </div>

