        <!-- Resumen del carrito -->
        <div class="col-md-4">
            <div class="cart-summary">
                <h4 style="color: var(--color-dark); font-weight: 700; margin-bottom: 20px;">
                    Resumen del Pedido
                </h4>
                
                <div class="cart-summary-row">
                    <span>Subtotal:</span>
                    <span>0,00€</span>
                </div>
                
                <div class="cart-summary-row">
                    <span>Envío:</span>
                    <span>Gratis</span>
                </div>
                
                <div class="cart-summary-row">
                    <span>Impuestos:</span>
                    <span>0,00€</span>
                </div>
                
                <div class="cart-summary-row total">
                    <span>Total:</span>
                    <span>0,00€</span>
                </div>

                <button class="btn btn-success btn-lg w-100 mb-2" disabled>
                    <i class="fas fa-credit-card"></i> Proceder al Pago
                </button>
                <a href="@Url.Action("Productos", "Home")" class="btn btn-outline-secondary w-100">
                    <i class="fas fa-arrow-left"></i> Continuar Comprando
                </a>
            </div>

            <!-- Beneficios -->
            <div class="mt-4 p-4 bg-light rounded">
                <h6 style="color: var(--color-dark); font-weight: 600; margin-bottom: 15px;">
                    <i class="fas fa-check-circle" style="color: var(--color-primary);"></i> Beneficios
                </h6>
                <ul class="list-unstyled text-muted" style="font-size: 0.9rem;">
                    <li><i class="fas fa-check" style="color: var(--color-primary); margin-right: 8px;"></i>Envío rápido</li>
                    <li><i class="fas fa-check" style="color: var(--color-primary); margin-right: 8px;"></i>Pago seguro</li>
                    <li><i class="fas fa-check" style="color: var(--color-primary); margin-right: 8px;"></i>Devoluciones fáciles</li>
                    <li><i class="fas fa-check" style="color: var(--color-primary); margin-right: 8px;"></i>Soporte 24/7</li>
