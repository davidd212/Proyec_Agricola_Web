@{
    ViewBag.Title = "Contacto - AgroVentas";
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success text-center" style="border-radius:0; margin:0;">
        <i class="fas fa-check-circle"></i> @TempData["MensajeExito"]
    </div>
}
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-warning text-center" style="border-radius:0; margin:0;">
        <i class="fas fa-exclamation-triangle"></i> @TempData["Mensaje"]
    </div>
}

<div class="bg-light py-3 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Inicio</a></li>
                <li class="breadcrumb-item active">Contacto</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container my-4">
    <h1 style="color: #2C3E50; font-weight: 700; margin-bottom: 8px;">
        <i class="fas fa-envelope" style="color: #27AE60;"></i> Contacto
    </h1>
    <p style="color: #666; margin-bottom: 30px;">Estamos aquí para ayudarte. Completa el formulario o comunícate con nosotros por los medios disponibles.</p>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card" style="border: none; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-body">
                    <h5 style="color: #2C3E50; font-weight: 600; margin-bottom: 16px;">
                        <i class="fas fa-map-marker-alt" style="color: #27AE60; margin-right: 8px;"></i> Dirección
                    </h5>
                    <p style="color: #666; margin:0;">Avenida Agrícola, 123<br>28001 Madrid<br>España</p>
                </div>
            </div>
            <div class="card mt-3" style="border: none; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-body">
                    <h5 style="color: #2C3E50; font-weight: 600; margin-bottom: 16px;">
                        <i class="fas fa-phone" style="color: #27AE60; margin-right: 8px;"></i> Teléfono
                    </h5>
                    <p style="color: #666; margin:0;">
                        <strong>Ventas:</strong><br>
                        <a href="tel:+34912345678" style="color: #27AE60; text-decoration: none;">+34 91 234 5678</a>
                    </p>
                    <p style="color: #666; margin:12px 0 0;">
                        <strong>Soporte:</strong><br>
                        <a href="tel:+34912345679" style="color: #27AE60; text-decoration: none;">+34 91 234 5679</a>
                    </p>
                </div>
            </div>
            <div class="card mt-3" style="border: none; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-body">
                    <h5 style="color: #2C3E50; font-weight: 600; margin-bottom: 16px;">
                        <i class="fas fa-envelope" style="color: #27AE60; margin-right: 8px;"></i> Email
                    </h5>
                    <p style="color: #666; margin:0;">
                        <strong>Información:</strong><br>
                        <a href="mailto:info@agroventas.com" style="color: #27AE60; text-decoration: none;">info@agroventas.com</a>
                    </p>
                    <p style="color: #666; margin:12px 0 0;">
                        <strong>Soporte:</strong><br>
                        <a href="mailto:soporte@agroventas.com" style="color: #27AE60; text-decoration: none;">soporte@agroventas.com</a>
                    </p>
                </div>
            </div>
            <div class="card mt-3" style="border: none; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-body">
                    <h5 style="color: #2C3E50; font-weight: 600; margin-bottom: 16px;">
                        <i class="fas fa-clock" style="color: #27AE60; margin-right: 8px;"></i> Horarios
                    </h5>
                    <p style="color: #666; margin:0;">
                        <strong>Lunes - Viernes:</strong> 08:00 - 20:00<br>
                        <strong>Sábado:</strong> 09:00 - 14:00<br>
                        <strong>Domingo:</strong> Cerrado
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-8 mb-4">
            <div class="card" style="border: none; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-header" style="background: linear-gradient(135deg, #27AE60 0%, #1e8449 100%); color: white;">
                    <h5 class="mb-0">Envíanos un mensaje</h5>
                </div>
                <div class="card-body p-4">
                    <form method="post" action="@Url.Action("EnviarContacto", "Home")" id="contactForm">
                        @Html.AntiForgeryToken()
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="nombre">Nombre</label>
                                <input class="form-control" type="text" id="nombre" name="nombre" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="email">Email</label>
                                <input class="form-control" type="email" id="email" name="email" required>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="telefono">Teléfono</label>
                                <input class="form-control" type="tel" id="telefono" name="telefono">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="asunto">Asunto</label>
                                <select class="form-control" id="asunto" name="asunto" required>
                                    <option value="">Selecciona un asunto</option>
                                    <option value="producto">Consulta sobre producto</option>
                                    <option value="pedido">Información de pedido</option>
                                    <option value="devolucion">Devoluciones</option>
                                    <option value="soporte">Soporte técnico</option>
                                    <option value="otro">Otro</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="mensaje">Mensaje</label>
                            <textarea class="form-control" id="mensaje" name="mensaje" rows="6" required></textarea>
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="privacidad" name="privacidad" required>
                                <label class="form-check-label" for="privacidad">
                                    Acepto la <a href="#" style="color: #27AE60;">política de privacidad</a>
                                </label>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success btn-lg" onclick="return validarFormulario();">
                            <i class="fas fa-paper-plane"></i> Enviar Mensaje
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function validarFormulario() {
            var nombre = document.getElementById('nombre').value;
            var email = document.getElementById('email').value;
            var mensaje = document.getElementById('mensaje').value;
            if (nombre.trim() === '' || email.trim() === '' || mensaje.trim() === '') {
                alert('Por favor completa todos los campos requeridos.');
                return false;
            }
            return true;
        }
    </script>
}
