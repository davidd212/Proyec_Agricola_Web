@model Proyec_Agricola_Web.Models.Producto
@{
    ViewBag.Title = Model.Nombre + " - AgroVentas";
}

<!-- Breadcrumb -->
<div class="bg-light py-3 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Inicio</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Productos", "Home")">Productos</a></li>
                <li class="breadcrumb-item active">@Model.Nombre</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container my-5">
    <div class="row">
        <!-- Imagen del producto -->
        <div class="col-md-5">
            <div class="product-image" style="height:420px; border-radius:16px; box-shadow:0 6px 24px rgba(0,0,0,0.1); background:#f9fff9; overflow:hidden;">
                @if (!string.IsNullOrEmpty(Model.ImagenRuta)) {
                    <img src="@Model.ImagenRuta" alt="@Model.Nombre"
                         style="width:100%; height:100%; object-fit:contain; padding:30px;"
                         onerror="this.onerror=null; this.style.display='none'; document.getElementById('detImgFallback').style.display='flex';" />
                    <div id="detImgFallback" style="display:none; height:100%; align-items:center; justify-content:center; flex-direction:column;">
                        <i class="fas fa-seedling fa-5x" style="color:#28a745; opacity:0.2;"></i>
                    </div>
                } else {
                    string fallbackPng = "";
                    switch (Model.CategoriaNombre) {
                        case "Semillas": fallbackPng = "/Content/Images/Productos/semillas-trigo.png"; break;
                        case "Fertilizantes": fallbackPng = "/Content/Images/Productos/fertilizante-npk.png"; break;
                        case "Pesticidas": fallbackPng = "/Content/Images/Productos/pesticida-organico.png"; break;
                        default: fallbackPng = ""; break;
                    }
                    if (!string.IsNullOrEmpty(fallbackPng)) {
                        <img src="@fallbackPng" alt="@Model.CategoriaNombre" style="width:100%; height:100%; object-fit:contain; padding:30px;" />
                    } else {
                        <div style="display:flex; align-items:center; justify-content:center; height:100%; flex-direction:column;">
                            <i class="fas fa-seedling fa-5x" style="color:#28a745; opacity:0.2;"></i>
                            <span class="text-muted mt-3">Sin imagen disponible</span>
                        </div>
                    }
                }
            </div>
        </div>
        </div>

        <!-- Información del producto -->
         <div class="col-md-7">
             <span class="product-category mb-3">@Model.CategoriaNombre</span>
            
            <h1 style="color: var(--color-dark); font-weight: 700; margin-bottom: 20px;">
                @Model.Nombre
            </h1>

            <!-- Rating (ejemplo) -->
            <div class="mb-3">
                <i class="fas fa-star" style="color: var(--color-accent);"></i>
                <i class="fas fa-star" style="color: var(--color-accent);"></i>
                <i class="fas fa-star" style="color: var(--color-accent);"></i>
                <i class="fas fa-star" style="color: var(--color-accent);"></i>
                <i class="fas fa-star-half-alt" style="color: var(--color-accent);"></i>
                <span class="ms-2 text-muted">(45 reseñas)</span>
            </div>

            <!-- Precio -->
            <div class="mb-4">
                <h2 class="product-price">@Model.Precio.ToString("C")</h2>
                <p class="text-success" style="font-weight: 600;">
                    <i class="fas fa-check-circle"></i> En stock
                </p>
            </div>

            <!-- Descripción -->
            <div class="mb-4">
                <h5 style="color: var(--color-dark); font-weight: 600;">Descripción</h5>
                <p>@Model.Descripcion</p>
            </div>

            <!-- Cantidad -->
            <div class="mb-4">
                <label class="form-label" style="color: var(--color-dark); font-weight: 600;">Cantidad</label>
                <div class="input-group" style="width: 150px;">
                    <button class="btn btn-outline-secondary" type="button" onclick="cambiarCantidad(-1)">-</button>
                    <input id="cantidadDetalle" type="number" class="form-control text-center" value="1" min="1" max="@Model.Stock">
                    <button class="btn btn-outline-secondary" type="button" onclick="cambiarCantidad(1)">+</button>
                </div>
            </div>

            <!-- Botones de acción -->
            <div class="d-grid gap-2">
                <button class="btn btn-success btn-lg mb-2" onclick="agregarAlCarrito()">
                    <i class="fas fa-cart-plus"></i> Agregar al Carrito
                </button>
                <button class="btn btn-outline-secondary btn-lg">
                    <i class="fas fa-heart"></i> Agregar a Favoritos
                </button>
            </div>

            <!-- Información adicional -->
            <div class="mt-5 pt-4 border-top">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <h6 style="color: var(--color-dark); font-weight: 600;">
                            <i class="fas fa-truck"></i> Envío
                        </h6>
                        <p class="text-muted">Envío gratis a partir de 50€</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <h6 style="color: var(--color-dark); font-weight: 600;">
                            <i class="fas fa-shield-alt"></i> Garantía
                        </h6>
                        <p class="text-muted">Garantía de satisfacción 100%</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <h6 style="color: var(--color-dark); font-weight: 600;">
                            <i class="fas fa-undo"></i> Devoluciones
                        </h6>
                        <p class="text-muted">Devuelve en 30 días sin preguntas</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <h6 style="color: var(--color-dark); font-weight: 600;">
                            <i class="fas fa-lock"></i> Pago Seguro
                        </h6>
                        <p class="text-muted">Transacciones 100% seguras</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Productos relacionados -->
    <div class="mt-5 pt-5 border-top">
        <h3 style="color: var(--color-dark); font-weight: 700; margin-bottom: 30px;">
            <i class="fas fa-link"></i> Productos Relacionados
        </h3>
        <div class="row">
            <div class="col-md-3">
                <div class="product-card">
                    <div class="product-image">
                        <img src="/Content/Images/semillas-trigo.png" alt="Semillas de Trigo" style="width: 100%; height: 100%; object-fit: contain; padding: 20px;" />
                    </div>
                    <div class="product-info">
                        <span class="product-category">Semillas</span>
                        <h5 class="product-title">Semillas de Trigo</h5>
                        <div class="product-price">12,00€</div>
                        <button class="btn btn-success btn-sm w-100">Agregar</button>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="product-card">
                    <div class="product-image">
                        <img src="/Content/Images/compost-organico.png" alt="Compost Orgánico" style="width: 100%; height: 100%; object-fit: contain; padding: 20px;" />
                    </div>
                    <div class="product-info">
                        <span class="product-category">Fertilizantes</span>
                        <h5 class="product-title">Compost Orgánico</h5>
                        <div class="product-price">20,00€</div>
                        <button class="btn btn-success btn-sm w-100">Agregar</button>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="product-card">
                    <div class="product-image">
                        <img src="/Content/Images/herbicida-selectivo.png" alt="Herbicida Selectivo" style="width: 100%; height: 100%; object-fit: contain; padding: 20px;" />
                    </div>
                    <div class="product-info">
                        <span class="product-category">Pesticidas</span>
                        <h5 class="product-title">Herbicida Selectivo</h5>
                        <div class="product-price">22,00€</div>
                        <button class="btn btn-success btn-sm w-100">Agregar</button>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="product-card">
                    <div class="product-image">
                        <img src="/Content/Images/semillas-maiz.png" alt="Semillas de Maíz" style="width: 100%; height: 100%; object-fit: contain; padding: 20px;" />
                    </div>
                    <div class="product-info">
                        <span class="product-category">Semillas</span>
                        <h5 class="product-title">Semillas de Maíz</h5>
                        <div class="product-price">15,50€</div>
                        <button class="btn btn-success btn-sm w-100">Agregar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function cambiarCantidad(delta) {
            var input = document.getElementById('cantidadDetalle');
            var val = parseInt(input.value) + delta;
            var max = parseInt(input.max);
            if (val < 1) val = 1;
            if (val > max) val = max;
            input.value = val;
        }

        function agregarAlCarrito() {
            var cantidad = parseInt(document.getElementById('cantidadDetalle').value);
            if (cantidad <= 0) {
                alert('La cantidad debe ser mayor a 0');
                return;
            }
            $.ajax({
                url: '@Url.Action("Agregar", "Carrito")',
                type: 'POST',
                data: {
                    productoID: @Model.ProductoID,
                    cantidad: cantidad
                },
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        $('#carrito-cantidad').text(response.cantidad);
                        document.getElementById('cantidadDetalle').value = 1;
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert('Error al agregar el producto al carrito');
                }
            });
        }
    </script>
}
