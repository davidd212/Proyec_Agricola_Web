@model Proyec_Agricola_Web.Models.Pedido

@{
    ViewBag.Title = "Pedido #" + Model.PedidoID + " - AgroVentas";
}

<div class="bg-light py-3 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Inicio</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Historial", "Pedido")">Mis Pedidos</a></li>
                <li class="breadcrumb-item active">Pedido #@Model.PedidoID</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container my-5">
    <div class="row">
        <div class="col-md-8">
            <div class="card p-4" style="border-radius: 12px; border: none; box-shadow: 0 2px 15px rgba(0,0,0,0.08);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
                    <h3 style="font-weight: 700; color: var(--color-dark); margin: 0;">
                        <i class="fas fa-receipt"></i> Pedido #@Model.PedidoID
                    </h3>
                    @switch (Model.Estado)
                    {
                        case "Pendiente":
                            <span class="badge bg-warning text-dark" style="font-size: 0.9rem; padding: 8px 20px;">Pendiente</span>
                            break;
                        case "Procesando":
                            <span class="badge bg-info text-white" style="font-size: 0.9rem; padding: 8px 20px;">Procesando</span>
                            break;
                        case "Enviado":
                            <span class="badge bg-primary" style="font-size: 0.9rem; padding: 8px 20px;">Enviado</span>
                            break;
                        case "Entregado":
                            <span class="badge bg-success" style="font-size: 0.9rem; padding: 8px 20px;">Entregado</span>
                            break;
                        case "Cancelado":
                            <span class="badge bg-danger" style="font-size: 0.9rem; padding: 8px 20px;">Cancelado</span>
                            break;
                        default:
                            <span class="badge bg-secondary" style="font-size: 0.9rem; padding: 8px 20px;">@Model.Estado</span>
                            break;
                    }
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px; padding: 20px; background: #f8f9fa; border-radius: 12px;">
                    <div>
                        <div style="font-size: 0.85rem; color: #666; margin-bottom: 5px;">Fecha del pedido</div>
                        <div style="font-weight: 600; color: var(--color-dark);">@Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div>
                        <div style="font-size: 0.85rem; color: #666; margin-bottom: 5px;">Dirección de envío</div>
                        <div style="font-weight: 600; color: var(--color-dark);">@Model.DireccionEnvio, @Model.CiudadEnvio @Model.CodigoPostalEnvio</div>
                    </div>
                    <div>
                        <div style="font-size: 0.85rem; color: #666; margin-bottom: 5px;">Teléfono de contacto</div>
                        <div style="font-weight: 600; color: var(--color-dark);">@(string.IsNullOrEmpty(Model.TelefonoEnvio) ? "No registrado" : Model.TelefonoEnvio)</div>
                    </div>
                    <div>
                        <div style="font-size: 0.85rem; color: #666; margin-bottom: 5px;">Notas</div>
                        <div style="font-weight: 600; color: var(--color-dark);">@(string.IsNullOrEmpty(Model.Notas) ? "Sin notas" : Model.Notas)</div>
                    </div>
                </div>

                <h5 style="font-weight: 600; margin-bottom: 15px;">
                    <i class="fas fa-box"></i> Productos
                </h5>

                @foreach (var item in Model.DetalleItems)
                {
                    <div style="display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid #eee;">
                        <div style="width: 60px; height: 60px; background: #f0f0f0; border-radius: 8px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                            @if (!string.IsNullOrEmpty(item.ImagenProducto))
                            {
                                <img src="@item.ImagenProducto" alt="@item.NombreProducto" style="width: 100%; height: 100%; object-fit: contain;" />
                            }
                            else
                            {
                                <i class="fas fa-seedling" style="color: var(--color-primary); font-size: 24px;"></i>
                            }
                        </div>
                        <div style="flex: 1;">
                            <div style="font-weight: 500; color: var(--color-dark);">@item.NombreProducto</div>
                            <div style="font-size: 0.85rem; color: #666;">@item.Cantidad x $@item.PrecioUnitario.ToString("F2")</div>
                        </div>
                        <div style="font-weight: 600; color: var(--color-dark);">$@item.PrecioTotal.ToString("F2")</div>
                    </div>
                }
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-4" style="border-radius: 12px; border: none; box-shadow: 0 2px 15px rgba(0,0,0,0.08);">
                <h5 style="font-weight: 600; margin-bottom: 20px;">
                    <i class="fas fa-calculator"></i> Resumen
                </h5>

                <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
                    <span style="color: #666;">Subtotal</span>
                    <span style="font-weight: 500;">$@Model.Subtotal.ToString("F2")</span>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
                    <span style="color: #666;">Envío</span>
                    <span style="color: var(--color-primary); font-weight: 600;">Gratis</span>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
                    <span style="color: #666;">IVA (16%)</span>
                    <span style="font-weight: 500;">$@Model.Impuesto.ToString("F2")</span>
                </div>
                <hr />
                <div style="display: flex; justify-content: space-between;">
                    <span style="font-size: 1.1rem; font-weight: 700; color: var(--color-dark);">Total</span>
                    <span style="font-size: 1.1rem; font-weight: 700; color: var(--color-primary);">$@Model.Total.ToString("F2")</span>
                </div>
            </div>

            <div style="margin-top: 15px;">
                <a href="@Url.Action("Historial", "Pedido")" class="btn btn-outline-secondary w-100" style="border-radius: 25px; padding: 10px;">
                    <i class="fas fa-arrow-left"></i> Volver a Mis Pedidos
                </a>
            </div>
        </div>
    </div>
</div>
